<mvc:View
    controllerName="project11.controller.Cart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="Cart" showNavButton="true" navButtonPress="onNavBack">

        <content>

            <MessageStrip
                id="undoStrip"
                text="Item removed"
                type="Warning"
                showCloseButton="true"
                visible="false">

                <link>
                    <Link text="UNDO" press="onUndoDelete"/>
                </link>

            </MessageStrip>

            <List
                items="{cart>/cartItems}"
                noDataText="No items in cart">

                <items>
                    <CustomListItem>
                        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">

                            <VBox width="55%">

                                <HBox>
                                    <Text text="Product Name:" width="120px"/>
                                    <Text text="{cart>ProductName}"/>
                                </HBox>

                                <HBox>
                                    <Text text="Price:" width="120px"/>
                                    <Text text="{= '$' + ${cart>Price} }"/>
                                </HBox>

                                <HBox>
                                    <Text text="Quantity:" width="120px"/>
                                    <Text text="{cart>Quantity}"/>
                                </HBox>

                                <HBox visible="{
                                    parts:[{path:'cart>Quantity'}],
                                    formatter:'.hasDiscount'
                                }">
                                    <Text text="Discount:" width="120px"/>
                                    <Text text="{
                                        parts:[{path:'cart>Quantity'}],
                                        formatter:'.getDiscountLabel'
                                    }"/>
                                </HBox>

                                <HBox visible="{
                                    parts:[{path:'cart>Quantity'}],
                                    formatter:'.hasDiscount'
                                }">
                                    <Text text="Saved Amount:" width="120px"/>
                                    <Text text="{
                                        parts:[
                                            {path:'cart>Price'},
                                            {path:'cart>Quantity'}
                                        ],
                                        formatter:'.getDiscountAmount'
                                    }"/>
                                </HBox>

                                <HBox>
                                    <Text text="Original Total:" width="120px"/>
                                    <Text text="{
                                        parts:[
                                            {path:'cart>Price'},
                                            {path:'cart>Quantity'}
                                        ],
                                        formatter:'.getOriginalTotal'
                                    }"/>
                                </HBox>

                                <HBox>
                                    <Text text="Final Total:" width="120px"/>
                                    <Text text="{
                                        parts:[
                                            {path:'cart>Price'},
                                            {path:'cart>Quantity'}
                                        ],
                                        formatter:'.getDiscountedTotal'
                                    }"/>
                                </HBox>

                            </VBox>

                            <VBox alignItems="Center">
                                <HBox alignItems="Center">
                                    <Button text="-" press="onDecrease"/>
                                    <Text text="{cart>Quantity}" width="30px" textAlign="Center"/>
                                    <Button text="+" press="onIncrease"/>
                                </HBox>
                            </VBox>

                            <Button
                                icon="sap-icon://delete"
                                type="Reject"
                                press="onRemove"/>

                        </HBox>
                    </CustomListItem>
                </items>

            </List>

        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Title
                    text="{
                        path:'cart>/cartItems',
                        formatter:'.getGrandTotal'
                    }"
                    level="H2"/>
            </Toolbar>
        </footer>

    </Page>

</mvc:View>